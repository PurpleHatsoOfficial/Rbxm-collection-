-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="435"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[local Hiding = false
local HidingPos = script.Parent.Parent.HidePosition
local ExitPos = script.Parent.Parent.ExitPosition
local sc = script.LockerClose
local so = script.LockerOpen
function Hide(Clicker)
	if Hiding == false and Clicker.Character.Humanoid.Health >= 1 then
		Hiding = true
		so:Play()
		workspace.CurrentCamera.CameraSubject = Clicker.Character.Head
		Clicker.Character.HumanoidRootPart.Anchored = true
		Clicker.Character.HumanoidRootPart.CFrame = CFrame.new(HidingPos.Position, ExitPos.Position)
		local Anim = Instance.new("Animation")
		Anim.AnimationId = "rbxassetid://6534522042"
		Anim.Name = "Enter"
		Anim.Parent = Clicker.Character
		local Hum = Clicker.Character.Humanoid:LoadAnimation(Clicker.Character.Enter)
		Hum:Play()
		wait(0.8)
		local Anim2 = Instance.new("Animation")
		Anim2.AnimationId = "rbxassetid://6534399775"
